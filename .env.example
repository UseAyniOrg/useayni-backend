# Transactional email: keep secrets on the backend only.
EMAIL_PROVIDER=mock
EMAIL_WORKER_ENABLED=false
EMAIL_DAILY_BUDGET=300
BREVO_API_KEY=
EMAIL_TOKEN_ENCRYPTION_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_TEST_RECIPIENT_ALLOWLIST=
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333
TENANT_BASE_DOMAIN=useayni.com

# Database Configuration
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=useayni

# Alternatively, use DATABASE_URL for cloud or portable connections:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/useayni
DATABASE_URL=postgres://user:password@localhost:5432/useayni
# You can also use PG* vars if you prefer:
PGHOST=localhost
PGDATABASE=useayni
PGUSER=postgres
PGPASSWORD=your_password
PGSSLMODE=require

# Server Configuration
PORT=3333
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Cloudflare R2 (required to start the API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket
