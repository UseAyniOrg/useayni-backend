<mjml lang="pt-BR">
  <mj-head>
    <mj-title>{{TITLE}}</mj-title>
    <mj-preview>{{PREVIEW}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#0d1b2a" font-size="16px" line-height="26px" padding="10px 24px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style inline="inline">a { color: #0e79b2; } .break-link { word-break: break-all; }</mj-style>
    <mj-style>@media (prefers-color-scheme: dark) { .email-surface, .email-surface div { background-color: #f1f1f1 !important; color: #0d1b2a !important; } }</mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#fafafa">
    <mj-section padding="24px 0 16px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#0e79b2">UseAyni</mj-text>
        <mj-text font-size="13px" line-height="20px" color="#475569">{{ORGANIZATION}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" css-class="email-surface" padding="16px 0 24px" border="1px solid #e2e8f0" border-radius="6px">
      <mj-column>
        <mj-raw>{{IMAGE_BLOCK}}</mj-raw>
        <mj-text><h1 style="font-size:24px;line-height:32px;margin:0;font-weight:700;">{{TITLE}}</h1></mj-text>
        <mj-text>{{BODY}}</mj-text>
        <mj-text font-size="14px" color="#475569">{{DETAILS}}</mj-text>
        <mj-raw>{{CODE_BLOCK}}</mj-raw>
        <mj-raw>{{ACTION_BLOCK}}</mj-raw>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 0 32px">
      <mj-column>
        <mj-text font-size="12px" line-height="20px" color="#475569">{{REASON}}<br />Mensagem automática enviada pelo UseAyni. Não responda a este endereço.</mj-text>
        <mj-text font-size="12px" line-height="20px" color="#475569"><a href="{{PRIVACY_URL}}">Privacidade</a> · <a href="{{TERMS_URL}}">Termos de uso</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>